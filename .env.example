# Puerto del servidor (opcional)
PORT=3000

# Cloudinary (solo si vas a usar la función de saludos de audio)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=radio_saludos

# Clave para leer la lista de saludos (dejala vacía para acceso libre)
ADMIN_TOKEN=

# Cantidad máxima de saludos guardados en memoria
MAX_SALUDOS=100
